{
  "name": "lumora-backend",
  "version": "1.0.0",
  "description": "Lumora - Document-grounded AI tutoring platform backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src/**/*.ts",
    "test:ai": "tsx --test src/modules/ai/ai.service.test.ts",
    "test:chunking": "tsx --test src/modules/documents/document-chunking.test.ts",
    "test:vector-search": "tsx --test src/modules/documents/document-vector-search.test.ts",
    "test:extraction": "python -m unittest discover -s python-worker/tests -v",
    "verify:t33": "tsx scripts/verify-chunking-embedding.ts",
    "verify:t34": "tsx scripts/verify-vector-search.ts",
    "verify:t35": "tsx scripts/verify-document-ready-notification.ts",
    "verify:t42": "tsx scripts/verify-ai-orchestrator.ts",
    "verify:t43": "tsx scripts/verify-conversations.ts",
    "verify:t44": "tsx scripts/verify-ai-chat.ts",
    "verify:t85": "tsx scripts/verify-email-verification.ts",
    "verify:t86": "tsx scripts/verify-email-verification-gate.ts",
    "verify:t87": "tsx scripts/verify-login-protection.ts",
    "verify:t84": "tsx scripts/verify-refresh-sessions.ts",
    "verify:t83": "tsx scripts/verify-auth-data-model.ts",
    "verify:t51": "tsx scripts/verify-flashcards.ts",
    "verify:t53": "tsx scripts/verify-quizzes.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.79.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
