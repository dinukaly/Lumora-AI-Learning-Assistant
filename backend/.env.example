# Environment Configuration
#
# Local Development Stack:
#   Storage:   Cloudflare R2 / S3-compatible bucket
#   Database:  MongoDB Atlas
#   AI:        OpenRouter
#   Vector:    MongoDB Atlas Vector Search
#   Redis:     Docker (localhost:6379)
#

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# TRUST_PROXY=1

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lumora?retryWrites=true&w=majority

# Auth (JWT)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (Phase 8 social auth backend)
# Backend-owned Authorization Code flow. Redirect URI must point to the backend callback route.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_MS=600000
# GOOGLE_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# GOOGLE_OAUTH_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Email delivery and verification
# Use `console` locally, `smtp` for dev/test SMTP servers, and `resend` for public deployment.
EMAIL_PROVIDER=console
EMAIL_FROM="Lumora <no-reply@lumora.local>"
EMAIL_VERIFICATION_URL_BASE=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# RESEND_API_KEY=re_xxxxxxxxx
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Chat Provider
# OpenRouter is a unified LLM gateway
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05

# Embedding Provider
# Options: google | huggingface | local
# Production default should be google unless you explicitly override it.
# Google: uses text-embedding-004 via API
# HuggingFace: uses sentence-transformers via Inference API
# Local: uses @xenova/transformers (zero-cost, offline, no API key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=20
# GOOGLE_API_KEY=your_google_ai_api_key_here
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# HUGGINGFACE_API_KEY=your_huggingface_token_here
# HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/pipeline/feature-extraction
# EMBEDDING_MODEL_CACHE_DIR=.cache/transformers

# Chunking
CHUNK_TARGET_TOKENS=750
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=150

# Atlas Vector Search
VECTOR_SEARCH_INDEX_NAME=document_chunks_vector_idx
VECTOR_SEARCH_SIMILARITY=cosine
VECTOR_SEARCH_DEFAULT_LIMIT=5
VECTOR_SEARCH_NUM_CANDIDATES_MULTIPLIER=20
VECTOR_SEARCH_AUTO_ENSURE=true
VECTOR_SEARCH_READY_TIMEOUT_MS=300000
VECTOR_SEARCH_READY_POLL_INTERVAL_MS=5000

# Storage (Cloudflare R2)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_BUCKET_NAME=lumora-documents
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# Avatar storage (Cloudflare R2 public bucket)
# Reuses S3 endpoint/credentials by default; override AVATAR_S3_* only if avatars use separate R2 credentials.
AVATAR_S3_BUCKET_NAME=lumora-avatars
AVATAR_PUBLIC_BASE_URL=https://<your-avatar-public-domain>
AVATAR_S3_FORCE_PATH_STYLE=true
AVATAR_S3_AUTO_CREATE_BUCKET=false
AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_OUTPUT_SIZE_PX=256
# AVATAR_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AVATAR_S3_REGION=auto
# AVATAR_S3_ACCESS_KEY_ID=<r2-access-key-id>
# AVATAR_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Redis (BullMQ for background jobs)
# Docker: docker run -p 6379:6379 redis:alpine
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://:password@host:6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=  #if you set a password
REDIS_TLS=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
LOGIN_PROTECTION_WINDOW_MS=900000
LOGIN_PROTECTION_MAX_ATTEMPTS=5
LOGIN_PROTECTION_LOCKOUT_MS=900000

# PDF extraction worker
PYTHON_EXECUTABLE=python
PDF_EXTRACTION_TIMEOUT_MS=120000

GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback